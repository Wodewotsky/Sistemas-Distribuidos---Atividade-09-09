import socket
cliente = socket.socket(
    socket.AF_INET,
    socket.SOCK_DGRAM
)

mensagem = input("Digite sua mensagem: ")

cliente.sendto(
    mensagem.encode(),
    ("localhost", 5000)
)

dados, servidor = cliente.recvfrom(1024)

print("Resposta do Servidor:")
print(dados.decode())

cliente.close()
